{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "type": "object"
      },
      "Language": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "native_name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "native_name",
          "direction"
        ],
        "type": "object"
      },
      "LanguageDTO": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "native_name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "native_name",
          "direction"
        ],
        "type": "object"
      },
      "PublicItem": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "type": "string"
          },
          "item_id": {
            "format": "uuid",
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "localized": {
            "additionalProperties": {
              "discriminator": {
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "string"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "text"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "markdown"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "enum"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "integer"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "decimal"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "datetime"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "boolean"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "object"
          },
          "publication_id": {
            "format": "uuid",
            "type": "string"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/PublicRelation"
            },
            "type": "array"
          },
          "schema_no": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "shared": {
            "additionalProperties": {
              "discriminator": {
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "string"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "text"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "markdown"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "enum"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "integer"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "decimal"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "datetime"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "boolean"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "object"
          },
          "slug": {
            "type": "string"
          },
          "translations": {
            "items": {
              "$ref": "#/components/schemas/PublicTranslation"
            },
            "type": "array"
          },
          "type_key": {
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "type_key",
          "schema_no",
          "publication_id",
          "language",
          "slug",
          "canonical_url",
          "translations",
          "shared",
          "localized",
          "relations"
        ],
        "type": "object"
      },
      "PublicPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicItem"
            },
            "type": "array"
          },
          "next_offset": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_offset"
        ],
        "type": "object"
      },
      "PublicProblem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "PublicRelation": {
        "additionalProperties": false,
        "properties": {
          "field_key": {
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/PublicTarget"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "field_key",
          "targets"
        ],
        "type": "object"
      },
      "PublicTarget": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "type": "string"
          },
          "item_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "canonical_url"
        ],
        "type": "object"
      },
      "PublicTranslation": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "language",
          "slug",
          "canonical_url"
        ],
        "type": "object"
      },
      "Publication": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array"
          },
          "messages": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "requested_language": {
            "description": "Normalized requested UI language; empty when omitted.",
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "version": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "version",
          "settings",
          "requested_language",
          "language",
          "languages",
          "messages"
        ],
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "accent": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "default_language": {
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "fallback_language": {
            "type": "string"
          },
          "notice": {
            "maxLength": 2000,
            "type": "string"
          },
          "tagline": {
            "maxLength": 300,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "tagline",
          "notice",
          "accent",
          "title",
          "description",
          "default_language",
          "fallback_language"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Stepolonia API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/content/{type_key}": {
      "get": {
        "description": "Publication time and item ID descending. No content language fallback or field predicates.",
        "operationId": "listContent",
        "parameters": [
          {
            "in": "path",
            "name": "type_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Content language (BCP 47).",
            "explode": false,
            "in": "query",
            "name": "language",
            "required": true,
            "schema": {
              "description": "Content language (BCP 47).",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "format": "int64",
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List published collection content"
      }
    },
    "/api/v1/content/{type_key}/{slug}": {
      "get": {
        "operationId": "getContent",
        "parameters": [
          {
            "in": "path",
            "name": "type_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "language",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicItem"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "301": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            },
            "description": "Historical slug; direct canonical API address in the same language.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get published content or its canonical address"
      }
    },
    "/api/v1/languages": {
      "get": {
        "operationId": "listLanguages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LanguageDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List active content languages"
      }
    },
    "/api/v1/site": {
      "get": {
        "description": "One atomic publication supplies settings, UI languages and messages. Omitted lang uses the configured UI fallback. No publication or disabled default/fallback returns 503. Drafts and historical versions are private.",
        "operationId": "getSite",
        "parameters": [
          {
            "description": "Optional requested UI language (BCP 47); unavailable catalogs use the configured fallback.",
            "explode": false,
            "in": "query",
            "name": "lang",
            "schema": {
              "description": "Optional requested UI language (BCP 47); unavailable catalogs use the configured fallback.",
              "type": "string"
            }
          },
          {
            "description": "Optional opaque UUID from a previous response; a different current publication returns 409.",
            "explode": false,
            "in": "query",
            "name": "version",
            "schema": {
              "description": "Optional opaque UUID from a previous response; a different current publication returns 409.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publication"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Read published site settings and one complete UI catalog"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  }
}
