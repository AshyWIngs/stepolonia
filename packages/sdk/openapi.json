{
  "components": {
    "schemas": {
      "ArticleDTO": {
        "additionalProperties": false,
        "properties": {
          "article_id": {
            "format": "uuid",
            "type": "string"
          },
          "body_markdown": {
            "type": "string"
          },
          "language_code": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "article_id",
          "language_code",
          "title",
          "slug",
          "body_markdown"
        ],
        "type": "object"
      },
      "ArticleDetailDTO": {
        "additionalProperties": false,
        "properties": {
          "article_id": {
            "format": "uuid",
            "type": "string"
          },
          "body_markdown": {
            "type": "string"
          },
          "language_code": {
            "type": "string"
          },
          "published_translations": {
            "description": "Published translations of this article in enabled content languages, ordered by language code. Each slug is canonical for its language.",
            "items": {
              "$ref": "#/components/schemas/PublishedTranslationDTO"
            },
            "type": "array"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "article_id",
          "language_code",
          "title",
          "slug",
          "body_markdown",
          "published_translations"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "type": "object"
      },
      "LanguageDTO": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "native_name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "native_name",
          "direction"
        ],
        "type": "object"
      },
      "PublicProblem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "PublishedTranslationDTO": {
        "additionalProperties": false,
        "properties": {
          "language_code": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "language_code",
          "slug"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Stepolonia API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/articles": {
      "get": {
        "description": "Ordered by publication time descending, then article ID descending. An active language with no articles returns an empty array. No language fallback.",
        "operationId": "listArticles",
        "parameters": [
          {
            "description": "Content language (BCP 47).",
            "explode": false,
            "in": "query",
            "name": "lang",
            "required": true,
            "schema": {
              "description": "Content language (BCP 47).",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ArticleDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List published articles in one content language"
      }
    },
    "/api/v1/articles/{slug}": {
      "get": {
        "description": "Missing, unpublished, disabled or untranslated content returns 404. No language fallback.",
        "operationId": "getArticle",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Content language (BCP 47).",
            "explode": false,
            "in": "query",
            "name": "lang",
            "required": true,
            "schema": {
              "description": "Content language (BCP 47).",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetailDTO"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "301": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            },
            "description": "Historical slug; Location points directly to the current address in the same content language.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get a published article or its canonical address"
      }
    },
    "/api/v1/languages": {
      "get": {
        "operationId": "listLanguages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LanguageDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List active content languages"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  }
}
