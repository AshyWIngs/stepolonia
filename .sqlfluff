# Migrations use PostgreSQL and Goose directives (-- +goose ...).
# Parse the PostgreSQL dialect without templating.
# The 128 KiB limit bounds parser input.
# Skipped files fail verification.
# Exempt only confirmed false positives at the affected lines.
[sqlfluff]
dialect = postgres
templater = raw
large_file_skip_byte_limit = 131072
large_file_skip_fail = True

# The lowercase name/version identifiers preserve the SQL interface. RF04
# disallows keywords, and RF06 removes unnecessary PostgreSQL quotes.
# RF04 still checks other keyword identifiers.
[sqlfluff:rules:references.keywords]
# Registry key and operation are approved persisted identifiers, not SQL syntax.
ignore_words = name,version,key,operation

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
